---
import { site } from '../data/site';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: '课程首页' },
  { href: '/courses/', label: '全部课程' },
  { href: '/about/', label: '课程团队' },
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${site.name} 首页`}>
      <span class="brand-mark" aria-hidden="true">AI</span>
      <span class="brand-copy">
        <strong>{site.name}</strong>
        <small>Learning Systems</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {links.map((link) => (
        <a class:list={{ active: pathname === link.href }} href={link.href}>{link.label}</a>
      ))}
    </nav>

    <a class="header-action" href={`mailto:${site.email}`}>联系课程组</a>

    <details class="mobile-nav">
      <summary aria-label="打开导航菜单"><span></span><span></span><span></span></summary>
      <nav aria-label="移动端主导航">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a href={`mailto:${site.email}`}>联系课程组</a>
      </nav>
    </details>
  </div>
</header>
