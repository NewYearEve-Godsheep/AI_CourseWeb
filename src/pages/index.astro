---
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredCourse, projects, site } from '../data/site';
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{site.courseCode} · {site.term}</p>
        <h1>{site.courseName}<br /><span>{site.courseNameEn}</span></h1>
        <p class="hero-lede">从 Transformer、Diffusion 到多模态 Agent、推理系统与 AI 硬件，完成从原理到应用的学习闭环。</p>
        <div class="hero-actions">
          <a class="button button--primary" href={`/courses/${featuredCourse.slug}/`}>查看课程介绍</a>
          <a class="button button--secondary" href="/projects/">浏览项目工作台</a>
        </div>
        <dl class="hero-facts" aria-label="课程信息">
          <div><dt>学分 / 学时</dt><dd>2 学分 · 36 学时</dd></div>
          <div><dt>授课语言</dt><dd>双语</dd></div>
          <div><dt>适用对象</dt><dd>研究生</dd></div>
        </dl>
      </div>
      <div class="course-visual" aria-label="从模型到应用的课程路径">
        <div class="visual-label"><span>AI DESIGN SYSTEM</span><span>COURSE STUDIO</span></div>
        <div class="visual-title">Model<br />to<br />Application</div>
        <div class="visual-board" aria-label="课程三步路径">
          <ol class="pathway">
            <li class="pathway-step">
              <span class="pathway-index">01</span>
              <span class="pathway-copy"><strong>Transform</strong><small>把问题转成可计算的表示</small></span>
              <span class="pathway-arrow" aria-hidden="true">↗</span>
            </li>
            <li class="pathway-step">
              <span class="pathway-index">02</span>
              <span class="pathway-copy"><strong>Reason</strong><small>用模型与证据验证判断</small></span>
              <span class="pathway-arrow" aria-hidden="true">↗</span>
            </li>
            <li class="pathway-step">
              <span class="pathway-index">03</span>
              <span class="pathway-copy"><strong>Build</strong><small>做成可运行、可评测的系统</small></span>
              <span class="pathway-arrow" aria-hidden="true">↗</span>
            </li>
          </ol>
        </div>
        <div class="visual-footer"><span>LECTURE + PRACTICE</span><span>02 CREDITS</span></div>
      </div>
    </div>
  </section>

  <section class="section course-intro">
    <div class="shell section-split">
      <div><p class="eyebrow">课程简介</p><h2>学习设计人工智能系统，而不只是使用模型。</h2></div>
      <div class="prose">
        <p>本课程面向研究生，系统介绍人工智能在设计与软件开发中的原理与实践。课程覆盖 Transformer、Diffusion、多模态与心理学导向的 AI Agent，以及 AI 推理扩展、BitNet 加速器和无存储计算等前沿议题。</p>
        <p>你将亲手实现简化模型、调用主流 API，并在综合项目中把理论、工程约束和跨学科问题连接起来。</p>
        <a class="text-link" href={`/courses/${featuredCourse.slug}/`}>查看课程信息 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">课程项目</p><h2>从可运行的最小版本开始。</h2></div><a class="text-link" href="/projects/">查看全部 6 个项目 <span aria-hidden="true">→</span></a></div>
      <div class="project-grid project-grid--preview">
        {projects.slice(0, 3).map((project) => <a class={`project-card project-card--${project.accent}`} href={`/projects/${project.slug}/`}><span class="project-card-number">{project.number}</span><span class="project-card-track">{project.track}</span><h3>{project.shortTitle}</h3><p>{project.summary}</p><span class="card-arrow" aria-hidden="true">↗</span></a>)}
      </div>
    </div>
  </section>

  <section class="section research-callout">
    <div class="shell research-callout-simple">
      <div><p class="eyebrow">科研方向</p><h2>把课程中的问题，继续做成研究。</h2><p class="prose">面向本科生和研究生开放有薪科研机会，包括兼职、暑期等形式。</p></div>
      <a class="button button--primary" href="/research/">了解科研方向</a>
    </div>
  </section>

</BaseLayout>
