---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import { courses, featuredCourse, site } from '../data/site';
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{site.courseCode} · {site.term}</p>
        <h1>让每一份算力，<br />发挥真正价值。</h1>
        <p class="hero-lede">
          从算法选择到系统部署，学习如何让人工智能在真实世界中更快、更轻、更可靠地运行。
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href={`/courses/${featuredCourse.slug}/`}>进入当前课程</a>
          <a class="button button--secondary" href="/courses/">浏览全部课程</a>
        </div>
        <dl class="hero-facts" aria-label="本学期课程信息">
          <div><dt>开课时间</dt><dd>周二、周四 14:00–15:30</dd></div>
          <div><dt>授课方式</dt><dd>讲授、讨论与实验</dd></div>
          <div><dt>课程地点</dt><dd>教学楼 A-201</dd></div>
        </dl>
      </div>

      <div class="course-visual" aria-label="高效 AI 系统课程主题视觉">
        <div class="visual-label">SYSTEM MAP</div>
        <div class="visual-title">Efficient<br />AI Systems</div>
        <div class="visual-board" aria-hidden="true">
          <span class="board-chip chip-a">Model</span>
          <span class="board-chip chip-b">Compile</span>
          <span class="board-chip chip-c">Deploy</span>
          <i class="board-line line-one"></i>
          <i class="board-line line-two"></i>
          <i class="board-node node-one"></i>
          <i class="board-node node-two"></i>
          <i class="board-node node-three"></i>
        </div>
        <div class="visual-footer"><span>06 Modules</span><span>2026.09</span></div>
      </div>
    </div>
  </section>

  <section class="section course-intro">
    <div class="shell section-split">
      <div>
        <p class="eyebrow">课程简介</p>
        <h2>用系统视角，理解高效智能。</h2>
      </div>
      <div class="prose">
        <p>
          大模型和视觉模型不断增长，但计算资源并不会无限增加。本课程聚焦高效机器学习与系统优化，讨论模型如何在边缘设备和云端基础设施中稳定落地。
        </p>
        <p>
          课程将穿插代码实验、论文讨论与小组项目，帮助你从原理走向可衡量的工程实践。
        </p>
        <a class="text-link" href={`/courses/${featuredCourse.slug}/`}>了解课程安排 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">课程目录</p>
          <h2>按你的学习阶段选择。</h2>
        </div>
        <a class="text-link" href="/courses/">查看全部 <span aria-hidden="true">→</span></a>
      </div>
      <div class="course-grid">
        {courses.map((course) => <CourseCard course={course} />)}
      </div>
    </div>
  </section>

  <section class="section resources-section">
    <div class="shell resources-grid">
      <div>
        <p class="eyebrow">学习资源</p>
        <h2>为每次课留下一条清晰路径。</h2>
      </div>
      <div class="resource-list">
        <a href={`/courses/${featuredCourse.slug}/#schedule`}><span>01</span><strong>课程安排与讲义</strong><i aria-hidden="true">→</i></a>
        <a href={`/courses/${featuredCourse.slug}/#assignments`}><span>02</span><strong>作业与项目说明</strong><i aria-hidden="true">→</i></a>
        <a href={`/courses/${featuredCourse.slug}/#policies`}><span>03</span><strong>课程规范与答疑</strong><i aria-hidden="true">→</i></a>
      </div>
    </div>
  </section>
</BaseLayout>
