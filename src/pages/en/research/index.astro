---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../data/site';
---

<BaseLayout locale="en" title={`Research directions | ${site.name}`} description="Research directions and opportunities with Professor Patrick Chiang's group.">
  <section class="page-hero research-hero"><div class="shell"><p class="eyebrow">FUDAN UNIVERSITY · RESEARCH</p><h1>Research directions</h1><p>Paid research opportunities are open to undergraduate and graduate students, including part-time and summer formats.</p></div></section>
  <section class="section"><div class="shell research-focus-grid"><div><p class="eyebrow">Research directions</p><h2>From AI models to systems and real-world applications.</h2></div><div class="research-focus-copy"><p>We work on AI design, model systems, AI hardware, and applications grounded in real settings. Research can begin with a paper, a well-defined question, a course project, or a personal interest.</p><div class="research-focus-tags"><span>AI systems</span><span>AI hardware</span><span>Model design</span><span>Real-world applications</span></div></div></div></section>
  <section class="section section--muted"><div class="shell research-opportunity-grid"><div><p class="eyebrow">Research opportunities</p><h2>Read, prototype, iterate.</h2><p class="prose">We welcome undergraduate and graduate students who enjoy reading deeply, building runnable prototypes, and iterating. Opportunities include paid research positions, with part-time and summer formats also available.</p></div><div class="opportunity-list"><div><span>01</span><strong>Who it suits</strong><p>Students with backgrounds in programming, mathematics, systems, machine learning, chips, or computer architecture who are curious about open problems.</p></div><div><span>02</span><strong>How we work</strong><p>Start from papers and problem definition, then move through experiments, prototypes, evaluation, and regular updates.</p></div><div><span>03</span><strong>What to send</strong><p>An English CV, three sentences about an idea you want to explore, and one representative past project.</p></div></div></div></section>
  <section id="faculty" class="section faculty-section"><div class="shell faculty-grid"><div class="faculty-portrait" aria-label="Faculty photograph">{site.instructorPhoto ? <img src={site.instructorPhoto} alt={site.instructorTitleEn} /> : <span>PHOTO<br />COMING SOON</span>}</div><div><p class="eyebrow">Faculty mentor</p><h2>{site.instructorTitleEn}</h2><p class="faculty-school">{site.schoolEn}</p><p class="prose">Professor Patrick Chiang received his BS from the University of California, Berkeley, and his PhD from Stanford University, where his doctoral advisor was Bill Dally, NVIDIA Chief Scientist. He was formerly a tenured professor at Oregon State University and is currently a full professor at Fudan University’s School of Microelectronics. He has published more than 200 papers and holds more than 30 patents. He is also the co-founder and CTO of PhotonIC Technologies.</p><div class="faculty-actions"><a class="button button--primary" href={`mailto:${site.email}`}>Send a research application</a>{site.instructorHomepage && <a class="button button--secondary button--dark" href={site.instructorHomepage} target="_blank" rel="noreferrer">Faculty homepage</a>}</div><p class="faculty-email">{site.email}</p></div></div></section>
  <section class="teaching-assistant-contact"><div class="shell teaching-assistant-contact__inner"><div class="teaching-assistant-contact__copy"><p class="eyebrow">Teaching assistant</p><h2>Course details</h2></div><a class="teaching-assistant-contact__email" href="mailto:luo_zj2025@163.com"><span>Email</span><strong>luo_zj2025@163.com</strong><span class="teaching-assistant-contact__arrow" aria-hidden="true">→</span></a></div></section>
  <section class="section research-poster-section"><div class="shell"><p class="eyebrow">Research poster</p><h2>Research opportunities</h2><div class="research-poster-slot"><img src={site.researchPoster} alt="Research opportunities poster from Professor Chiang's group" /></div></div></section>
</BaseLayout>
