---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { courses, site } from '../../../data/site';
---

<BaseLayout locale="en" title={`Course | ${site.name}`} description="AI design and application course information and project directions.">
  <section class="page-hero"><div class="shell"><p class="eyebrow">Course</p><h1>One course,<br />real questions.</h1><p>From deep learning, Transformers, and diffusion to AI agents, inference systems, and integrated projects.</p></div></section>
  <section class="section catalog-section"><div class="shell"><div class="course-grid">{courses.map((course) => <article class={`course-card course-card--${course.accent}`}><div class="course-card-topline"><span>{course.code}</span><span class="course-status">Current course</span></div><h3><a href={`/en/courses/${course.slug}/`}>AI Design: Introduction &amp; Fundamentals</a></h3><p>Explore the principles and practice of artificial intelligence design, from core models to real-world systems.</p><div class="course-card-meta"><span>{site.termEn}</span><span>Graduate</span></div><div class="topic-list" aria-label="Course topics"><span>Transformers</span><span>Diffusion</span><span>AI Agents</span><span>AI Hardware</span></div><a class="text-link" href={`/en/courses/${course.slug}/`}>View course <span aria-hidden="true">→</span></a></article>)}</div></div></section>
</BaseLayout>
