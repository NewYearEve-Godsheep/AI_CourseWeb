---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/CourseCard.astro';
import { courses } from '../../data/site';
---

<BaseLayout title="课程目录 | AICourse" description="浏览全部课程与历年课程资料。">
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">课程目录</p>
      <h1>把学习，放进<br />合适的节奏里。</h1>
      <p>按主题、难度和开课状态浏览课程。所有课程资料都可在详情页持续更新。</p>
    </div>
  </section>

  <section class="section catalog-section">
    <div class="shell">
      <div class="catalog-controls">
        <label class="search-field">
          <span class="sr-only">搜索课程</span>
          <input id="course-search" type="search" placeholder="搜索课程名称、主题或课程号" autocomplete="off" />
        </label>
        <div class="filter-group" aria-label="按课程难度筛选">
          <button class="filter-button is-active" type="button" data-filter="all">全部</button>
          <button class="filter-button" type="button" data-filter="基础">基础</button>
          <button class="filter-button" type="button" data-filter="进阶">进阶</button>
          <button class="filter-button" type="button" data-filter="专题">专题</button>
        </div>
      </div>
      <p id="empty-state" class="empty-state" hidden>没有找到匹配的课程。</p>
      <div id="course-list" class="course-grid">
        {courses.map((course) => <CourseCard course={course} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#course-search');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-course]');
  const emptyState = document.querySelector<HTMLElement>('#empty-state');
  let activeFilter = 'all';

  const updateCourses = () => {
    const query = input?.value.trim().toLowerCase() ?? '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const course = JSON.parse(card.dataset.course ?? '{}');
      const searchable = [course.code, course.title, course.description, ...(course.topics ?? [])]
        .join(' ')
        .toLowerCase();
      const matchesQuery = searchable.includes(query);
      const matchesFilter = activeFilter === 'all' || course.level === activeFilter;
      const isVisible = matchesQuery && matchesFilter;
      card.hidden = !isVisible;
      visibleCount += Number(isVisible);
    });

    if (emptyState) emptyState.hidden = visibleCount > 0;
  };

  input?.addEventListener('input', updateCourses);
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = button.dataset.filter ?? 'all';
      buttons.forEach((item) => item.classList.toggle('is-active', item === button));
      updateCourses();
    });
  });
</script>
