---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
---

<BaseLayout title={`科研方向 | ${site.name}`} description="姜培教授课题组的研究方向与科研机会。">
  <section class="page-hero research-hero"><div class="shell"><p class="eyebrow">FUDAN UNIVERSITY · RESEARCH</p><h1>科研方向</h1><p>面向本科生和研究生开放有薪科研机会，包括兼职、暑期等形式。</p></div></section>
  <section class="section"><div class="shell research-focus-grid"><div><p class="eyebrow">研究方向</p><h2>从人工智能模型，到系统与真实应用。</h2></div><div class="research-focus-copy"><p>我们关注人工智能设计、模型系统、AI 硬件和面向真实场景的应用问题。研究从论文阅读和问题定义开始，也欢迎从课程项目或个人兴趣出发。</p><div class="research-focus-tags"><span>AI systems</span><span>AI hardware</span><span>Model design</span><span>Real-world applications</span></div></div></div></section>
  <section class="section section--muted"><div class="shell research-opportunity-grid"><div><p class="eyebrow">科研机会</p><h2>读论文，做原型，快速迭代。</h2><p class="prose">欢迎愿意深入阅读、构建可运行原型并持续迭代的本科生和研究生。机会包括有薪科研岗位，也支持兼职和暑期形式。</p></div><div class="opportunity-list"><div><span>01</span><strong>适合人群</strong><p>具备编程、数学、系统、机器学习、芯片或体系结构背景，对开放问题有好奇心。</p></div><div><span>02</span><strong>工作方式</strong><p>从论文和问题定义开始，完成实验、原型、评测和阶段性汇报。</p></div><div><span>03</span><strong>申请材料</strong><p>英文简历、三句话说明感兴趣的想法，以及一个有代表性的过往项目。</p></div></div></div></section>
  <section id="faculty" class="section faculty-section"><div class="shell faculty-grid"><div class="faculty-portrait" aria-label="教师照片预留区域">{site.instructorPhoto ? <img src={site.instructorPhoto} alt={site.instructorTitle} /> : <span>PHOTO<br />COMING SOON</span>}</div><div><p class="eyebrow">Faculty Mentor</p><h2>{site.instructorTitle}</h2><p class="faculty-school">{site.school}</p><p class="prose">姜培教授本科毕业于加州大学伯克利分校（UC Berkeley），博士毕业于斯坦福大学（Stanford），博士导师为 Bill Dally（NVIDIA Chief Scientist）。他曾任美国俄勒冈州立大学终身教职教授，现任复旦大学微电子学院教授，已发表 200 余篇论文并拥有 30 余项专利。同时是 PhotonIC Technologies 的联合创始人兼 CTO。</p><div class="faculty-actions"><a class="button button--primary" href={`mailto:${site.email}`}>发送研究申请邮件</a>{site.instructorHomepage && <a class="button button--secondary button--dark" href={site.instructorHomepage} target="_blank" rel="noreferrer">查看教师个人主页</a>}</div><p class="faculty-email">{site.email}</p></div></div></section>
  <section class="teaching-assistant-contact"><div class="shell teaching-assistant-contact__inner"><div class="teaching-assistant-contact__copy"><p class="eyebrow">课程教学助理</p><h2>发送课程细节咨询</h2></div><a class="teaching-assistant-contact__email" href="mailto:luo_zj2025@163.com"><span>Email</span><strong>luo_zj2025@163.com</strong><span class="teaching-assistant-contact__arrow" aria-hidden="true">→</span></a></div></section>
  <section class="section research-poster-section"><div class="shell"><p class="eyebrow">Research Poster</p><h2>科研海报</h2><div class="research-poster-slot"><img src={site.researchPoster} alt="姜培教授课题组科研招募海报" /></div></div></section>
</BaseLayout>
